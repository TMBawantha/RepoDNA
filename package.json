    "test:run": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^9.39.5",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
